# Шаблон переменных окружения Laravel.
# Разделы и ключи отсортированы по алфавиту; исходные строки сохранены.
# Закомментированные образцы DB_* оставлены как в исходном файле.

# -----------------------------------------------------------------------------
# APP — Приложение Laravel
# Название проекта, окружение, адрес приложения, локализация и режим отладки.
# APP_KEY — секрет шифрования Laravel: не публикуйте и не меняйте на работающем сайте без плана миграции.
# -----------------------------------------------------------------------------
APP_DEBUG=true
APP_ENV=local
APP_FAKER_LOCALE=en_US
APP_FALLBACK_LOCALE=en
APP_KEY=
APP_LOCALE=en
APP_MAINTENANCE_DRIVER=file
APP_MAINTENANCE_STORE=database
APP_NAME=Laravel
APP_TIMEZONE=UTC
APP_URL=http://localhost

# -----------------------------------------------------------------------------
# AWS — Объектное хранилище AWS / S3
# Учетные данные, регион, корзина (bucket) и способ формирования адресов S3.
# Заполняется, если приложение использует совместимое с S3 хранилище.
# -----------------------------------------------------------------------------
AWS_ACCESS_KEY_ID=
AWS_BUCKET=
AWS_DEFAULT_REGION=us-east-1
AWS_SECRET_ACCESS_KEY=
AWS_USE_PATH_STYLE_ENDPOINT=false

# -----------------------------------------------------------------------------
# BCRYPT — Хеширование паролей
# Настройка сложности алгоритма Bcrypt для создания хешей паролей.
# -----------------------------------------------------------------------------
BCRYPT_ROUNDS=12

# -----------------------------------------------------------------------------
# BROADCAST — Трансляция событий
# Драйвер доставки событий в реальном времени (например, Laravel Reverb).
# -----------------------------------------------------------------------------
BROADCAST_CONNECTION=log

# -----------------------------------------------------------------------------
# CACHE — Кеширование
# Драйвер/хранилище кеша и префикс ключей для разделения данных проектов.
# -----------------------------------------------------------------------------
CACHE_PREFIX=
CACHE_STORE=database

# -----------------------------------------------------------------------------
# DB — База данных
# Драйвер СУБД, адрес, порт, имя базы и учетные данные подключения.
# -----------------------------------------------------------------------------
DB_CONNECTION=sqlite

# Примеры параметров для подключения к отдельному серверу БД (пока отключены):
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

# -----------------------------------------------------------------------------
# FILES — Файловые хранилища и медиа
# Диски Laravel для файлов, медиа и публичного хранения.
# Конкретные реализации задаются в config/filesystems.php и конфигурации медиабиблиотеки.
# -----------------------------------------------------------------------------
FILESYSTEM_DISK=local

# -----------------------------------------------------------------------------
# LOG — Журналирование
# Каналы, набор каналов и уровень подробности логов Laravel.
# -----------------------------------------------------------------------------
LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug
LOG_STACK=single

# -----------------------------------------------------------------------------
# MAIL — Электронная почта
# Почтовый транспорт SMTP, сервер, порт, авторизация и адрес отправителя.
# MAIL_FROM_NAME может ссылаться на APP_NAME, определенный выше.
# -----------------------------------------------------------------------------
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"
MAIL_HOST=127.0.0.1
MAIL_MAILER=log
MAIL_PASSWORD=null
MAIL_PORT=2525
MAIL_USERNAME=null

# -----------------------------------------------------------------------------
# MEMCACHED — Memcached
# Адрес сервера Memcached, если используется это хранилище кеша.
# -----------------------------------------------------------------------------
MEMCACHED_HOST=127.0.0.1

# -----------------------------------------------------------------------------
# QUEUE — Очереди фоновых заданий
# Драйвер очереди Laravel для выполнения заданий воркерами.
# -----------------------------------------------------------------------------
QUEUE_CONNECTION=database

# -----------------------------------------------------------------------------
# REDIS — Redis — кеш, сессии и служебные данные
# Клиент и параметры соединения с Redis; номера БД для разных типов данных.
# -----------------------------------------------------------------------------
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# -----------------------------------------------------------------------------
# SESSION — Сессии пользователей
# Драйвер хранения, срок действия, шифрование, путь и домен cookie сессий.
# -----------------------------------------------------------------------------
SESSION_DOMAIN=null
SESSION_DRIVER=database
SESSION_ENCRYPT=false
SESSION_LIFETIME=120
SESSION_PATH=/

# -----------------------------------------------------------------------------
# VITE — Vite — настройки фронтенда
# Переменные, передаваемые клиентской сборке: адрес dev-сервера и параметры WebSocket.
# Значения VITE_* могут оказаться в браузере: серверные секреты сюда не помещать.
# PUSHER_*, REVERB_* и APP_NAME, на которые есть ссылки, определены выше.
# -----------------------------------------------------------------------------
VITE_APP_NAME="${APP_NAME}"
