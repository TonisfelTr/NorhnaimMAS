# Шаблон локальной конфигурации NorhnaimMAS.
# Список параметров и порядок групп синхронизированы с рабочим .env.
# Секреты и пароли очищены: заполните их локально, не добавляйте этот файл с секретами в Git.
# Для APP_KEY выполните: php artisan key:generate

# -----------------------------------------------------------------------------
# APP — Приложение Laravel
# Название проекта, окружение, адрес приложения и режим отладки.
# APP_KEY — секрет шифрования Laravel; создаётся отдельно для каждого окружения.
# -----------------------------------------------------------------------------
# APP_DEBUG — Включает подробные сообщения об ошибках; true использовать только в локальной разработке.
APP_DEBUG=true
# APP_ENV — Окружение приложения: local, staging или production.
APP_ENV=local
# APP_KEY — Ключ шифрования Laravel; создать командой php artisan key:generate, не копировать из другого окружения.
APP_KEY=
# APP_NAME — Отображаемое название приложения.
APP_NAME=NorhnaimMAS
# APP_URL — Базовый URL приложения; для production указывать публичный HTTPS-адрес.
APP_URL=http://localhost:8080

# -----------------------------------------------------------------------------
# AWS — Объектное хранилище AWS / S3
# Учетные данные, регион, корзина и параметры совместимого с S3 хранилища.
# -----------------------------------------------------------------------------
# AWS_ACCESS_KEY_ID — Идентификатор ключа доступа AWS; заполнять только при использовании AWS/S3.
AWS_ACCESS_KEY_ID=
# AWS_BUCKET — Имя S3 bucket для файлов.
AWS_BUCKET=
# AWS_DEFAULT_REGION — Регион AWS, в котором расположен bucket.
AWS_DEFAULT_REGION=us-east-1
# AWS_SECRET_ACCESS_KEY — Секретный ключ AWS; не публиковать и не коммитить.
AWS_SECRET_ACCESS_KEY=
# AWS_USE_PATH_STYLE_ENDPOINT — Использовать path-style URL для S3-совместимого хранилища.
AWS_USE_PATH_STYLE_ENDPOINT=false

# -----------------------------------------------------------------------------
# BROADCAST — Трансляция событий
# Драйвер доставки событий в реальном времени; CONNECTION — актуальный параметр, DRIVER — совместимость со старой конфигурацией.
# -----------------------------------------------------------------------------
# BROADCAST_CONNECTION — Основной драйвер трансляции событий Laravel.
BROADCAST_CONNECTION=reverb
# BROADCAST_DRIVER — Устаревший алиас драйвера трансляции для совместимости.
BROADCAST_DRIVER=reverb

# -----------------------------------------------------------------------------
# CACHE — Кеширование
# Драйвер кеша и префикс ключей для разделения данных проектов.
# -----------------------------------------------------------------------------
# CACHE_DRIVER — Драйвер кеша, используемый приложением.
CACHE_DRIVER=redis
# CACHE_PREFIX — Префикс ключей кеша; помогает разделять кеш нескольких приложений.
CACHE_PREFIX="${APP_NAME}_cache"

# -----------------------------------------------------------------------------
# DADATA — DaData — подсказки и проверка данных
# Ключ доступа к внешнему API DaData; хранится только на сервере.
# -----------------------------------------------------------------------------
# DADATA_API_KEY — Секретный API-ключ DaData.
DADATA_API_KEY=

# -----------------------------------------------------------------------------
# DB — База данных
# Драйвер СУБД, адрес, порт, имя базы и учетные данные подключения.
# -----------------------------------------------------------------------------
# DB_CONNECTION — Драйвер подключения к базе данных: pgsql, mysql или sqlite.
DB_CONNECTION=pgsql
# DB_DATABASE — Имя базы данных.
DB_DATABASE=laravel
# DB_HOST — Хост или имя сервиса базы данных.
DB_HOST=pgsql
# DB_PASSWORD — Пароль пользователя базы данных; заполнить в локальном секретном .env.
DB_PASSWORD=
# DB_PORT — Порт сервера базы данных.
DB_PORT=5432
# DB_USERNAME — Пользователь базы данных.
DB_USERNAME=sail

# -----------------------------------------------------------------------------
# DEV — Разработка и отладка
# PHP IDE и Xdebug/Sail; эти параметры не нужны на production-сервере.
# -----------------------------------------------------------------------------
# PHP_IDE_CONFIG — Имя сервера для сопоставления проекта с конфигурацией PHP IDE.
PHP_IDE_CONFIG=serverName=laravel.test
# SAIL_XDEBUG_CONFIG — Параметры подключения Xdebug к IDE.
SAIL_XDEBUG_CONFIG="client_host=127.0.0.1 client_port=9003 start_with_request=yes"
# SAIL_XDEBUG_MODE — Режимы Xdebug; отключить на production.
SAIL_XDEBUG_MODE=debug,develop

# -----------------------------------------------------------------------------
# FILES — Файловые хранилища и медиа
# Диски Laravel для файлов, медиа и публичного хранения.
# -----------------------------------------------------------------------------
# FILESYSTEM_DISK — Диск Laravel по умолчанию для файлов.
FILESYSTEM_DISK=local
# MEDIA_DISK — Диск хранения медиафайлов.
MEDIA_DISK=public
# STORAGE_DRIVER — Диск/драйвер, используемый приложением для хранения файлов.
STORAGE_DRIVER=public

# -----------------------------------------------------------------------------
# LLM — Выбор провайдера языковой модели
# Провайдер, через который приложение обращается к языковым моделям.
# -----------------------------------------------------------------------------
# LLM_PROVIDER — Активный провайдер языковой модели, например ollama или openai.
LLM_PROVIDER=ollama

# -----------------------------------------------------------------------------
# LOG — Журналирование
# Каналы журналирования и уровень подробности логов Laravel.
# -----------------------------------------------------------------------------
# LOG_CHANNEL — Основной канал журналирования Laravel.
LOG_CHANNEL=stack
# LOG_DEPRECATIONS_CHANNEL — Канал для сообщений об устаревающих функциях.
LOG_DEPRECATIONS_CHANNEL=null
# LOG_LEVEL — Минимальный уровень сообщений, записываемых в журнал.
LOG_LEVEL=debug

# -----------------------------------------------------------------------------
# MAIL — Электронная почта
# Почтовый транспорт SMTP, сервер, порт, авторизация и адрес отправителя.
# MAIL_PASSWORD — пароль SMTP; в шаблонах оставлен пустым.
# -----------------------------------------------------------------------------
# MAIL_ENCRYPTION — Шифрование SMTP-соединения: tls, ssl или null в зависимости от сервера.
MAIL_ENCRYPTION=null
# MAIL_FROM_ADDRESS — Адрес отправителя электронной почты.
MAIL_FROM_ADDRESS="hello@example.com"
# MAIL_FROM_NAME — Имя отправителя; может ссылаться на APP_NAME.
MAIL_FROM_NAME="${APP_NAME}"
# MAIL_HOST — Адрес SMTP-сервера.
MAIL_HOST=mailpit
# MAIL_MAILER — Почтовый транспорт Laravel, например smtp или log.
MAIL_MAILER=smtp
# MAIL_PASSWORD — Пароль SMTP; хранить только в секретной конфигурации окружения.
MAIL_PASSWORD=
# MAIL_PORT — Порт SMTP-сервера.
MAIL_PORT=1025
# MAIL_USERNAME — Имя пользователя SMTP.
MAIL_USERNAME=null

# -----------------------------------------------------------------------------
# MEDGEMMA — MedGemma — диагностика
# Параметры отладки модели; запись медицинских ответов в логи требует особой осторожности.
# -----------------------------------------------------------------------------
# MEDGEMMA_DEBUG_LOG_RESPONSES — Разрешает запись ответов MedGemma в логи; в production рекомендуется false из-за медицинских данных.
MEDGEMMA_DEBUG_LOG_RESPONSES=true

# -----------------------------------------------------------------------------
# NDX — Анализ текста анамнеза
# Флаги и пороги встроенного анализатора: использование LLM, кеш, объем текста и число предложений.
# -----------------------------------------------------------------------------
# NDX_CACHE_TTL — Время жизни кеша анализатора, в секундах.
NDX_CACHE_TTL=600
# NDX_FALLBACK_PROMPT_LIMIT — Лимит для резервного промпта анализатора; точное значение определяется кодом NDX.
NDX_FALLBACK_PROMPT_LIMIT=120
# NDX_LLM_ALWAYS_ON — Принудительно использовать LLM в анализаторе, если это предусмотрено его логикой.
NDX_LLM_ALWAYS_ON=true
# NDX_MAX_RAW_BEFORE_LLM — Порог объёма исходного текста перед передачей в LLM.
NDX_MAX_RAW_BEFORE_LLM=140
# NDX_MIN_POSITIVE_FOR_NO_LLM — Минимальное количество положительных признаков для сценария без LLM.
NDX_MIN_POSITIVE_FOR_NO_LLM=5
# NDX_MIN_SENTENCES — Минимальное количество предложений для анализа.
NDX_MIN_SENTENCES=15

# -----------------------------------------------------------------------------
# OLLAMA — Локальные модели ИИ через Ollama
# URL сервиса, модели, контекст, температура, таймауты и время удержания модели в памяти.
# -----------------------------------------------------------------------------
# OLLAMA_BASE_URL — Внутренний URL сервиса Ollama.
OLLAMA_BASE_URL=http://ollama:11434
# OLLAMA_CONNECT_TIMEOUT — Таймаут установления соединения с Ollama, в секундах.
OLLAMA_CONNECT_TIMEOUT=10
# OLLAMA_KEEP_ALIVE — Время удержания модели в памяти Ollama после запроса.
OLLAMA_KEEP_ALIVE=5m
# OLLAMA_MODEL — Модель Ollama по умолчанию.
OLLAMA_MODEL=qwen3:14b
# OLLAMA_NUM_CTX — Размер контекстного окна основной модели.
OLLAMA_NUM_CTX=12288
# OLLAMA_PRIMARY_MODEL — Основная модель для первичного ответа.
OLLAMA_PRIMARY_MODEL=qwen3:14b
# OLLAMA_REVIEW_ENABLED — Включает дополнительную проверку ответа отдельной моделью.
OLLAMA_REVIEW_ENABLED=true
# OLLAMA_REVIEW_KEEP_ALIVE — Время удержания проверяющей модели в памяти.
OLLAMA_REVIEW_KEEP_ALIVE=0
# OLLAMA_REVIEW_MAX_TOKENS — Максимальное количество токенов ответа проверяющей модели.
OLLAMA_REVIEW_MAX_TOKENS=1800
# OLLAMA_REVIEW_MODEL — Модель для дополнительной проверки.
OLLAMA_REVIEW_MODEL=medgemma1.5:4b
# OLLAMA_REVIEW_NUM_CTX — Размер контекстного окна проверяющей модели.
OLLAMA_REVIEW_NUM_CTX=16384
# OLLAMA_REVIEW_TEMPERATURE — Температура генерации проверяющей модели.
OLLAMA_REVIEW_TEMPERATURE=0.0
# OLLAMA_REVIEW_THINK — Включает режим reasoning/thinking у проверяющей модели, если поддерживается.
OLLAMA_REVIEW_THINK=false
# OLLAMA_REVIEW_TIMEOUT — Максимальное время ожидания ответа проверяющей модели, в секундах.
OLLAMA_REVIEW_TIMEOUT=300
# OLLAMA_TEMPERATURE — Температура генерации основной модели.
OLLAMA_TEMPERATURE=0.0
# OLLAMA_THINK — Включает режим reasoning/thinking основной модели, если поддерживается.
OLLAMA_THINK=false
# OLLAMA_TIMEOUT — Максимальное время ожидания ответа Ollama, в секундах.
OLLAMA_TIMEOUT=300

# -----------------------------------------------------------------------------
# OPENAI — OpenAI API
# Секретный ключ для серверных вызовов OpenAI; не передавать в клиентский код.
# -----------------------------------------------------------------------------
# OPENAI_API_KEY — Секретный API-ключ OpenAI.
OPENAI_API_KEY=

# -----------------------------------------------------------------------------
# PUSHER — Pusher — события реального времени
# Идентификатор приложения, публичный ключ и серверный секрет Pusher.
# -----------------------------------------------------------------------------
# PUSHER_APP_CLUSTER — Региональный кластер Pusher.
PUSHER_APP_CLUSTER=mt1
# PUSHER_APP_ID — Идентификатор приложения Pusher.
PUSHER_APP_ID=
# PUSHER_APP_KEY — Публичный ключ приложения Pusher.
PUSHER_APP_KEY=
# PUSHER_APP_SECRET — Секрет приложения Pusher; хранить только на сервере.
PUSHER_APP_SECRET=
# PUSHER_HOST — Хост Pusher или совместимого WebSocket-сервера.
PUSHER_HOST=
# PUSHER_PORT — Порт подключения к Pusher.
PUSHER_PORT=443
# PUSHER_SCHEME — Схема соединения с Pusher: http или https.
PUSHER_SCHEME=https

# -----------------------------------------------------------------------------
# QUEUE — Очереди фоновых заданий
# Драйвер очереди Laravel для выполнения фоновых заданий воркерами.
# -----------------------------------------------------------------------------
# QUEUE_CONNECTION — Драйвер очередей Laravel, например database или rabbitmq.
QUEUE_CONNECTION=rabbitmq

# -----------------------------------------------------------------------------
# RABBITMQ — RabbitMQ — брокер очередей
# Подключение к брокеру: хост, порт, пользователь, пароль и имя очереди.
# -----------------------------------------------------------------------------
# RABBITMQ_HOST — Хост RabbitMQ.
RABBITMQ_HOST=rabbitmq
# RABBITMQ_PASSWORD — Пароль пользователя RabbitMQ.
RABBITMQ_PASSWORD=
# RABBITMQ_PORT — Порт RabbitMQ.
RABBITMQ_PORT=5672
# RABBITMQ_QUEUE — Имя очереди RabbitMQ по умолчанию.
RABBITMQ_QUEUE=default
# RABBITMQ_USER — Имя пользователя RabbitMQ.
RABBITMQ_USER=laravel

# -----------------------------------------------------------------------------
# RECAPTCHAV3 — Google reCAPTCHA v3
# Публичный ключ сайта и серверный секрет проверки на ботов.
# -----------------------------------------------------------------------------
RECAPTCHAV3_LOCALE=ru
RECAPTCHAV3_SECRET=
RECAPTCHAV3_SITEKEY=6LcvicgrAAAAAEvW-bwPAhMsLcyyv3cbXvLEoTow

# -----------------------------------------------------------------------------
# REDIS — Redis — кеш, сессии и служебные данные
# Клиент, адрес Redis, пароль и номера баз данных для разных типов данных.
# -----------------------------------------------------------------------------
# REDIS_CACHE_DB — Номер базы Redis для кеша.
REDIS_CACHE_DB=1
# REDIS_CLIENT — PHP-клиент Redis, например phpredis.
REDIS_CLIENT=phpredis
# REDIS_DB — Номер основной базы Redis.
REDIS_DB=0
# REDIS_HOST — Хост Redis.
REDIS_HOST=redis
# REDIS_PASSWORD — Пароль Redis; оставить пустым, если аутентификация не используется.
REDIS_PASSWORD=
# REDIS_PORT — Порт Redis.
REDIS_PORT=6379

# -----------------------------------------------------------------------------
# REVERB — Laravel Reverb — WebSocket
# Идентификатор приложения, ключи, серверный адрес и внешний порт WebSocket.
# -----------------------------------------------------------------------------
# REVERB_APP_ID — Идентификатор приложения Laravel Reverb.
REVERB_APP_ID=
# REVERB_APP_KEY — Публичный ключ приложения Reverb.
REVERB_APP_KEY=
# REVERB_APP_SECRET — Секрет приложения Reverb; не передавать в браузер.
REVERB_APP_SECRET=
# REVERB_HOST — Внутренний или публичный хост сервера Reverb в зависимости от контекста.
REVERB_HOST=reverb
# REVERB_PORT — Внутренний порт сервера Reverb.
REVERB_PORT=8080
# REVERB_PUBLIC_PORT — Порт Reverb, доступный браузеру через прокси/публикацию Docker.
REVERB_PUBLIC_PORT=8082
# REVERB_SCHEME — Схема подключения к Reverb: http или https.
REVERB_SCHEME=http

# -----------------------------------------------------------------------------
# SESSION — Сессии пользователей
# Драйвер хранения и срок действия пользовательских сессий.
# -----------------------------------------------------------------------------
# SESSION_DRIVER — Хранилище пользовательских сессий Laravel.
SESSION_DRIVER=redis
# SESSION_LIFETIME — Срок жизни сессии в минутах.
SESSION_LIFETIME=120

# -----------------------------------------------------------------------------
# SMSRU — SMS.RU — отправка SMS
# API ID для серверной отправки сервисных SMS; хранить только в локальном секретном .env.
# -----------------------------------------------------------------------------
# SMSRU_API_ID — Секретный API ID SMS.RU для отправки сервисных SMS.
SMSRU_API_ID=

# -----------------------------------------------------------------------------
# TELEMEDICINE — Телемедицина, аудит и напоминания
# Секрет аудита, разрешённые источники, SMS-провайдер и интервалы уведомлений.
# TELEMEDICINE_DOCTOR_NOTICE_MINUTES_BEFORE — уведомление врачу в панели (минут до сеанса).
# TELEMEDICINE_SMS_MINUTES_BEFORE — SMS с короткой ссылкой (минут до сеанса).
# SMS врачу отправляется только при включённом согласии в профиле врача.
# -----------------------------------------------------------------------------
# TELEMEDICINE_AUDIT_SECRET — Секрет для защиты аудита телемедицинского модуля; сгенерировать отдельно для каждого окружения.
TELEMEDICINE_AUDIT_SECRET=
# TELEMEDICINE_DOCTOR_NOTICE_MINUTES_BEFORE — За сколько минут до сеанса создать уведомление врачу в панели.
TELEMEDICINE_DOCTOR_NOTICE_MINUTES_BEFORE=30
# TELEMEDICINE_EXTRA_ALLOWED_ORIGINS — Дополнительные разрешённые origins для телемедицинских запросов; перечислять только доверенные HTTPS-адреса.
TELEMEDICINE_EXTRA_ALLOWED_ORIGINS=https://charlotte-audio-cat-byte.trycloudflare.com
# TELEMEDICINE_SMS_DRIVER — SMS-провайдер для напоминаний о телемедицинских сеансах, например smsru.
TELEMEDICINE_SMS_DRIVER=smsru
# TELEMEDICINE_SMS_MINUTES_BEFORE — За сколько минут до сеанса отправлять SMS со ссылкой участнику.
TELEMEDICINE_SMS_MINUTES_BEFORE=15

# -----------------------------------------------------------------------------
# VITE — Vite — настройки фронтенда
# Переменные клиентской сборки. Значения VITE_* доступны браузеру — секреты здесь запрещены.
# Все VITE_* значения доступны браузеру; пароли и приватные токены сюда не помещать.
# -----------------------------------------------------------------------------
# VITE_APP_NAME — Название приложения, доступное клиентской сборке Vite.
VITE_APP_NAME="${APP_NAME}"
# VITE_HOST — Адрес, на котором слушает Vite dev server.
VITE_HOST=0.0.0.0
# VITE_PORT — Порт Vite dev server.
VITE_PORT=5175
# VITE_PUSHER_APP_CLUSTER — Кластер Pusher, передаваемый клиентской сборке.
VITE_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"
# VITE_PUSHER_APP_KEY — Публичный ключ Pusher для браузера; не использовать здесь секреты.
VITE_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
# VITE_PUSHER_HOST — Хост WebSocket/Pusher, используемый браузером.
VITE_PUSHER_HOST="${PUSHER_HOST}"
# VITE_PUSHER_PORT — Порт WebSocket/Pusher для браузера.
VITE_PUSHER_PORT="${PUSHER_PORT}"
# VITE_PUSHER_SCHEME — Схема WebSocket/Pusher для браузера.
VITE_PUSHER_SCHEME="${PUSHER_SCHEME}"
# VITE_REVERB_APP_KEY — Публичный ключ Reverb для браузера; должен соответствовать REVERB_APP_KEY.
VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
# VITE_REVERB_HOST — Хост Reverb, доступный браузеру.
VITE_REVERB_HOST=localhost
# VITE_REVERB_PORT — Публичный порт Reverb, доступный браузеру.
VITE_REVERB_PORT=8082
# VITE_REVERB_SCHEME — Схема WebSocket Reverb для браузера.
VITE_REVERB_SCHEME=http

# -----------------------------------------------------------------------------
# WWWGROUP — WWWGROUP
# Параметры соответствующего сервиса.
# -----------------------------------------------------------------------------
# WWWGROUP — Числовой GID пользователя внутри Docker/Sail.
WWWGROUP=1000

# -----------------------------------------------------------------------------
# WWWUSER — WWWUSER
# Параметры соответствующего сервиса.
# -----------------------------------------------------------------------------
# WWWUSER — Числовой UID пользователя внутри Docker/Sail.
WWWUSER=1000

# -----------------------------------------------------------------------------
# YANDEX_MAPS — Яндекс Карты
# Ключ API картографических сервисов; ограничить его разрешёнными доменами и API.
# -----------------------------------------------------------------------------
# YANDEX_MAPS_API_KEY — API-ключ Яндекс Карт; ограничить разрешёнными доменами и необходимыми API.
YANDEX_MAPS_API_KEY=
