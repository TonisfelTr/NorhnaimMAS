services:
  laravel.test:
    build:
      context: ./vendor/laravel/sail/runtimes/8.5
      dockerfile: Dockerfile
      args:
        WWWGROUP: "${WWWGROUP:-1000}"
    image: sail-8.5/app
    restart: unless-stopped
    init: true
    extra_hosts:
      - "host.docker.internal:host-gateway"
    ports:
      - "${APP_PORT:-8080}:80"
      - "${VITE_PORT:-5173}:${VITE_PORT:-5173}"
    environment:
      WWWUSER: "${WWWUSER:-1000}"
      LARAVEL_SAIL: "1"
      XDEBUG_MODE: "${SAIL_XDEBUG_MODE:-off}"
      XDEBUG_CONFIG: "${SAIL_XDEBUG_CONFIG:-client_host=host.docker.internal client_port=9003 start_with_request=yes}"
      PHP_IDE_CONFIG: "${PHP_IDE_CONFIG:-serverName=laravel.test}"
      IGNITION_LOCAL_SITES_PATH: "${PWD}"
      OLLAMA_URL: "${OLLAMA_URL:-http://ollama:11434}"
      OLLAMA_BASE_URL: "${OLLAMA_BASE_URL:-http://ollama:11434}"
    volumes:
      - ".:/var/www/html"
    networks:
      - sail
    depends_on:
      pgsql:
        condition: service_healthy
      redis:
        condition: service_healthy
      rabbitmq:
        condition: service_healthy
      ollama:
        condition: service_healthy
    healthcheck:
      test:
        - CMD-SHELL
        - "php artisan about >/dev/null 2>&1 || exit 1"
      interval: 15s
      timeout: 10s
      retries: 10
      start_period: 40s

  laravel.worker:
    build:
      context: ./vendor/laravel/sail/runtimes/8.5
      dockerfile: Dockerfile
      args:
        WWWGROUP: "${WWWGROUP:-1000}"
    image: sail-8.5/app
    restart: unless-stopped
    init: true
    stop_grace_period: 30s
    extra_hosts:
      - "host.docker.internal:host-gateway"
    environment:
      WWWUSER: "${WWWUSER:-1000}"
      LARAVEL_SAIL: "1"
      XDEBUG_MODE: "${SAIL_XDEBUG_MODE:-off}"
      XDEBUG_CONFIG: "${SAIL_XDEBUG_CONFIG:-client_host=host.docker.internal client_port=9003 start_with_request=yes}"
      PHP_IDE_CONFIG: "${PHP_IDE_CONFIG:-serverName=laravel.test}"
      OLLAMA_URL: "${OLLAMA_URL:-http://ollama:11434}"
      OLLAMA_BASE_URL: "${OLLAMA_BASE_URL:-http://ollama:11434}"
    volumes:
      - ".:/var/www/html"
    networks:
      - sail
    depends_on:
      laravel.test:
        condition: service_healthy
      pgsql:
        condition: service_healthy
      redis:
        condition: service_healthy
      rabbitmq:
        condition: service_healthy
      ollama:
        condition: service_healthy
    command:
      - php
      - artisan
      - queue:work
      - rabbitmq
      - "--queue=${RABBITMQ_QUEUE:-default}"
      - "--sleep=3"
      - "--tries=3"
      - "--backoff=5"
      - "--timeout=${QUEUE_TIMEOUT:-900}"
      - "--memory=${QUEUE_MEMORY:-512}"
      - "--max-jobs=${QUEUE_MAX_JOBS:-1000}"
      - "--max-time=${QUEUE_MAX_TIME:-3600}"

  pgsql:
    image: postgres:15-alpine
    restart: unless-stopped
    shm_size: "${POSTGRES_SHM_SIZE:-256mb}"
    ports:
      - "127.0.0.1:${FORWARD_DB_PORT:-5432}:5432"
    environment:
      PGPASSWORD: "${DB_PASSWORD:-secret}"
      POSTGRES_DB: "${DB_DATABASE:-laravel}"
      POSTGRES_USER: "${DB_USERNAME:-sail}"
      POSTGRES_PASSWORD: "${DB_PASSWORD:-secret}"
    volumes:
      - "sail-pgsql:/var/lib/postgresql/data"
      - "./vendor/laravel/sail/database/pgsql/create-testing-database.sql:/docker-entrypoint-initdb.d/10-create-testing-database.sql:ro"
    networks:
      - sail
    healthcheck:
      test:
        - CMD-SHELL
        - 'pg_isready -q -d "$${POSTGRES_DB}" -U "$${POSTGRES_USER}"'
      interval: 10s
      timeout: 5s
      retries: 10
      start_period: 20s

  redis:
    image: redis:7-alpine
    restart: unless-stopped
    ports:
      - "127.0.0.1:${FORWARD_REDIS_PORT:-6379}:6379"
    command:
      - redis-server
      - --appendonly
      - "yes"
      - --appendfsync
      - everysec
      - --maxmemory
      - "${REDIS_MAXMEMORY:-512mb}"
      - --maxmemory-policy
      - "${REDIS_MAXMEMORY_POLICY:-allkeys-lru}"
    volumes:
      - "sail-redis:/data"
    networks:
      - sail
    healthcheck:
      test:
        - CMD
        - redis-cli
        - ping
      interval: 10s
      timeout: 5s
      retries: 10
      start_period: 10s

  rabbitmq:
    image: rabbitmq:3-management-alpine
    restart: unless-stopped
    ports:
      - "127.0.0.1:${FORWARD_RABBITMQ_PORT:-5672}:5672"
      - "127.0.0.1:${FORWARD_RABBITMQ_MANAGEMENT_PORT:-15672}:15672"
    environment:
      RABBITMQ_DEFAULT_USER: "${RABBITMQ_USER:-guest}"
      RABBITMQ_DEFAULT_PASS: "${RABBITMQ_PASSWORD:-guest}"
      RABBITMQ_DEFAULT_VHOST: "${RABBITMQ_VHOST:-/}"
    volumes:
      - "sail-rabbitmq:/var/lib/rabbitmq"
      - "./docker/rabbitmq/rabbitmq.conf:/etc/rabbitmq/rabbitmq.conf:ro"
      - "./docker/rabbitmq/definitions.json:/etc/rabbitmq/definitions.json:ro"
    networks:
      - sail
    healthcheck:
      test:
        - CMD
        - rabbitmq-diagnostics
        - -q
        - ping
      interval: 10s
      timeout: 5s
      retries: 10
      start_period: 20s

  pgadmin4:
    image: dpage/pgadmin4:latest
    restart: unless-stopped
    profiles:
      - tools
    ports:
      - "121.0.0.0:${FORWARD_PGADMIN_PORT:-5111}:8080"
    environment:
      PGADMIN_DEFAULT_EMAIL: "${PGADMIN_DEFAULT_EMAIL:-admin@example.com}"
      PGADMIN_DEFAULT_PASSWORD: "${PGADMIN_DEFAULT_PASSWORD:-password}"
      PGADMIN_CONFIG_SERVER_MODE: "False"
      PGADMIN_CONFIG_MASTER_PASSWORD_REQUIRED: "False"
    volumes:
      - "sail-pgadmin:/var/lib/pgadmin"
    networks:
      - sail
    depends_on:
      pgsql:
        condition: service_healthy

  ollama:
    image: ollama/ollama:latest
    restart: unless-stopped
    init: true

    # NVIDIA Container Toolkit должен быть установлен на хосте.
    # Если runtime "nvidia" недоступен, сервис завершится ошибкой,
    # а не запустит модели незаметно только на CPU.
    runtime: nvidia

    ports:
      - "127.0.0.1:${FORWARD_OLLAMA_PORT:-11434}:11434"
    environment:
      OLLAMA_HOST: "0.0.0.0:11434"
      OLLAMA_KEEP_ALIVE: "${OLLAMA_KEEP_ALIVE:--1}"
      OLLAMA_MAX_LOADED_MODELS: "${OLLAMA_MAX_LOADED_MODELS:-1}"
      OLLAMA_NUM_PARALLEL: "${OLLAMA_NUM_PARALLEL:-1}"
      OLLAMA_MAX_QUEUE: "${OLLAMA_MAX_QUEUE:-512}"
      OLLAMA_CONTEXT_LENGTH: "${OLLAMA_CONTEXT_LENGTH:-4096}"
      OLLAMA_FLASH_ATTENTION: "${OLLAMA_FLASH_ATTENTION:-1}"
      OLLAMA_KV_CACHE_TYPE: "${OLLAMA_KV_CACHE_TYPE:-q8_0}"
      OLLAMA_NO_CLOUD: "${OLLAMA_NO_CLOUD:-1}"
      NVIDIA_VISIBLE_DEVICES: "${NVIDIA_VISIBLE_DEVICES:-all}"
      NVIDIA_DRIVER_CAPABILITIES: "${NVIDIA_DRIVER_CAPABILITIES:-compute,utility}"
    volumes:
      - "ollama-data:/root/.ollama"
    networks:
      - sail

    # Современный Docker Compo  se использует эту секцию для запроса GPU.
    # runtime: nvidia оставлен выше для совместимости.
    deploy:
      resources:
        reservations:
          devices:
            - driver: nvidia
              count: all
              capabilities:
                - gpu

    healthcheck:
      test:
        - CMD
        - ollama
        - list
      interval: 10s
      timeout: 10s
      retries: 12
      start_period: 45s

networks:
  sail:
    driver: bridge

volumes:
  sail-pgsql:
    driver: local
  sail-redis:
    driver: local
  sail-rabbitmq:
    driver: local
  sail-pgadmin:
    driver: local
  ollama-data:
